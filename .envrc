# direnv configuration for training-mate.
#
# Loads .env (gitignored) into the current shell so any process started here
# inherits STRAVA_*, GARMIN_*, GOOGLE_*, TM_* env vars. This matters because
# Claude Code interpolates ${VAR} placeholders in .mcp.json against the
# launching shell's process env at startup; without direnv, MCP servers
# spawn with empty env and either fall back to disk config (Strava), 429-loop
# (Garmin), or fail-fast (Google Calendar).
#
# First-time setup:
#   brew install direnv
#   echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc
#   source ~/.zshrc
#   cd /path/to/training-mate
#   direnv allow
#
# After that, every `cd` into this repo auto-sources .env.

dotenv
