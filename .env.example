# Copy to .env and fill in. .env is gitignored.

# Strava — create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Garmin Connect — your normal account credentials.
# Used only for first-time setup via the upstream MCP server (handles MFA).
# After that, tokens in ~/.garmin-mcp/ are reused.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Google Calendar
# 1. Create a Google Cloud project, enable the Calendar API, create a Desktop OAuth client.
# 2. Download the credentials JSON, save it somewhere safe, point GOOGLE_OAUTH_CREDENTIALS at it.
# 3. First time the google-calendar MCP server runs, it opens a browser to complete OAuth.
GOOGLE_OAUTH_CREDENTIALS=
# Optional override; defaults to ~/.config/google-calendar-mcp/
GOOGLE_CALENDAR_MCP_TOKEN_PATH=

# The calendar Claude writes training events to.
# Create this calendar manually in Google Calendar (e.g. "Training") before first use.
TM_CALENDAR_NAME=Training

# Safety: never push workouts to Garmin without explicit confirmation.
TM_GARMIN_DRYRUN=true
