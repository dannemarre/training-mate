# Copy to .env and fill in. .env is gitignored.

# Strava — create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Garmin Connect — your normal account credentials.
# Used only for first-time setup via the upstream MCP server (handles MFA).
# After that, tokens in ~/.garmin-mcp/ are reused.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Safety: never push workouts to Garmin without explicit confirmation.
TM_GARMIN_DRYRUN=true
